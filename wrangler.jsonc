{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phodong-jongno",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "phodong-db"
    }
  ]
}
